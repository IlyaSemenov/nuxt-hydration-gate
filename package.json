{
  "name": "nuxt-hydration-gate",
  "version": "0.1.0",
  "description": "Nuxt hydration marker for CSS, scripts, and E2E tests.",
  "keywords": [
    "hydration",
    "nuxt",
    "nuxt-module",
    "playwright",
    "ssr"
  ],
  "homepage": "https://github.com/IlyaSemenov/nuxt-hydration-gate#readme",
  "bugs": "https://github.com/IlyaSemenov/nuxt-hydration-gate/issues",
  "license": "MIT",
  "author": "Ilya Semenov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaSemenov/nuxt-hydration-gate.git"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.mts",
      "import": "./dist/playwright.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "nuxt-module-build build && publint",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "prepare": "lefthook install",
    "prepublishOnly": "bun run build",
    "test": "bun run build && nuxt build tests/fixtures/nuxt && NUXT_TEST_SPA=1 nuxt build tests/fixtures/nuxt && playwright test",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@nuxt/module-builder": "^1.0.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "nuxt": "^4.5.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "publint": "^0.3.22",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.44.0",
    "nuxt": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "packageManager": "bun@1.4.2"
}
